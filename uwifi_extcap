# ~/.local/lib/wireshark/extcap/uwifi_extcap   (chmod +x)
import argparse, json, os, re, subprocess, sys

UWIFI = "/usr/local/bin/uwifi"          # confirm with: command -v uwifi
CACHE = os.path.expanduser("~/.cache/uwifi_extcap.json")
LOG   = "/tmp/uwifi_extcap.log"


# ---- cache / adapter discovery ---------------------------------------------
def load_cache():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except Exception:
        return {"adapters": [], "info": {}}


def save_cache(c):
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w") as f:
        json.dump(c, f)


def get_adapters():
    """Parse `uwifi list`; fall back to the cached list if it fails."""
    try:
        out = subprocess.run([UWIFI, "list"], capture_output=True,
                             text=True, timeout=15).stdout
        ad = []
        for line in out.splitlines()[1:]:
            p = line.split()
            if len(p) >= 6:
                ad.append({"index": int(p[0]), "name": p[1], "driver": p[2],
                           "usbid": p[3], "path": p[4], "speed": p[5]})
        if ad:
            c = load_cache()
            c["adapters"] = ad
            save_cache(c)
            return ad
    except Exception:
        pass
    return load_cache().get("adapters", [])


# ---- parse `uwifi info` -----------------------------------------------------
def parse_info(text):
    bands, cur, in_ch = {}, None, False
    for line in text.splitlines():
        m = re.match(r"^(2\.4|5|6)GHz band", line)
        if m:
            cur, in_ch = m.group(1), False
            bands[cur] = {"channels": [], "widths": []}
            continue
        if cur is None:
            continue
        if re.match(r"^\s+Channels:", line):
            in_ch = True
            continue
        if in_ch:
            if re.match(r"^[\d\s]+$", line) and line.strip():
                bands[cur]["channels"] += [int(x) for x in line.split()]
                continue
            in_ch = False
        m = re.match(r"^\s+Widths:\s+(.*)", line)
        if m:
            bands[cur]["widths"] = [int(w.replace("MHz", ""))
                                    for w in m.group(1).split()]
    return bands


def refresh_one(ad):
    """Run `uwifi info` for one adapter, update the cache, return bands or None."""
    try:
        r = subprocess.run(["sudo", "-n", UWIFI, "info", "-d", str(ad["index"])],
                           capture_output=True, text=True, timeout=90)
    except Exception as e:
        with open(LOG, "a") as f:
            f.write("info %s failed: %s\n" % (ad["name"], e))
        return None
    b = parse_info(r.stdout)
    if not b:
        with open(LOG, "a") as f:
            f.write("info %s: no bands parsed: %s\n" %
                    (ad["name"], r.stderr.strip()[:300]))
        return None
    c = load_cache()
    c.setdefault("info", {})[ad["name"]] = b
    save_cache(c)
    return b


def refresh():
    for a_ in get_adapters():
        sys.stderr.write("Reading %s (index %d)...\n" % (a_["name"], a_["index"]))
        b = refresh_one(a_)
        if b:
            sys.stderr.write("  " + ", ".join(
                "%sGHz:%d ch" % (k, len(v["channels"])) for k, v in b.items()) + "\n")


# ---- channel combinations ---------------------------------------------------
P40_5 = [(36, 40), (44, 48), (52, 56), (60, 64), (100, 104), (108, 112),
         (116, 120), (124, 128), (132, 136), (140, 144), (149, 153),
         (157, 161), (165, 169), (173, 177)]
B80_5 = [(36, 40, 44, 48), (52, 56, 60, 64), (100, 104, 108, 112),
         (116, 120, 124, 128), (132, 136, 140, 144), (149, 153, 157, 161),
         (165, 169, 173, 177)]
# Kismet 160MHz spellings. Unverified against uwifi, so check before relying on them.
SFX160_5 = "VHT160"
SFX160_6 = "HE160"
B160_5 = [tuple(range(36, 65, 4)), tuple(range(100, 129, 4)), tuple(range(149, 178, 4))]

def combos(info):
    out = []
    if "2.4" in info:
        out.append(("hop:2", "Hop 2.4GHz"))
    if "5" in info:
        out.append(("hop:5", "Hop 5GHz"))
    if "2.4" in info and "5" in info:
        out.append(("hop:2,5", "Hop 2.4+5GHz"))
    if "6" in info:
        out.append(("hop:6", "Hop 6GHz"))
    for band, label in (("2.4", "2.4GHz"), ("5", "5GHz"), ("6", "6GHz")):
        if band not in info:
            continue
        ch, w = set(info[band]["channels"]), info[band]["widths"]
        pre = "6g:" if band == "6" else ""
        for c in sorted(ch):
            out.append(("%s%d" % (pre, c), "%s ch %d  20MHz" % (label, c)))
        if 40 in w and band == "2.4":
            for c in sorted(ch):
                if c + 4 in ch and c <= 9:
                    out.append(("%dHT40+" % c,
                                "%s ch %d  40MHz (HT40+)" % (label, c)))
                if c - 4 in ch and c >= 5:
                    out.append(("%dHT40-" % c,
                                "%s ch %d  40MHz (HT40-)" % (label, c)))
        if 40 in w and band == "5":
            for lo, hi in P40_5:
                if lo in ch and hi in ch:
                    out.append(("%dHT40+" % lo,
                                "%s ch %d  40MHz (HT40+)" % (label, lo)))
                    out.append(("%dHT40-" % hi,
                                "%s ch %d  40MHz (HT40-)" % (label, hi)))
        if 80 in w and band == "5":
            for blk in B80_5:
                if all(x in ch for x in blk):
                    out.append(("%dVHT80" % blk[0],
                                "%s ch %d  80MHz (VHT80, %d-%d)" %
                                (label, blk[0], blk[0], blk[-1])))
        if 80 in w and band == "6":
            for s in range(1, 234, 16):
                if all(x in ch for x in (s, s + 4, s + 8, s + 12)):
                    out.append(("6g:%dHE80" % s,
                                "%s ch %d  80MHz (HE80, %d-%d)" %
                                (label, s, s, s + 12)))
        if 160 in w and band == "5":
            for blk in B160_5:
                if all(x in ch for x in blk):
                    out.append(("%d%s" % (blk[0], SFX160_5),
                                "%s ch %d  160MHz (%s, %d-%d)" %
                                (label, blk[0], SFX160_5, blk[0], blk[-1])))
        if 160 in w and band == "6":
            for s in range(1, 234, 32):
                blk = [s + 4 * i for i in range(8)]
                if all(x in ch for x in blk):
                    out.append(("6g:%d%s" % (s, SFX160_6),
                                "%s ch %d  160MHz (%s, %d-%d)" %
                                (label, s, SFX160_6, s, blk[-1])))
    return out


def print_values(info):
    if info:
        for v, d in combos(info):
            dflt = "{default=true}" if v == "6" else ""
            print("value {arg=0}{value=%s}{display=%s}%s" % (v, d, dflt))
    else:
        print("value {arg=0}{value=6}{display=2.4GHz ch 6}{default=true}")
        print("value {arg=0}{value=hop:2,5}{display=Hop 2.4+5GHz}")


# ---- main -------------------------------------------------------------------
ap = argparse.ArgumentParser(allow_abbrev=False)
ap.add_argument("--extcap-interfaces", action="store_true")
ap.add_argument("--extcap-version", nargs="?")
ap.add_argument("--extcap-dlts", action="store_true")
ap.add_argument("--extcap-config", action="store_true")
ap.add_argument("--extcap-interface")
ap.add_argument("--extcap-reload-option")
ap.add_argument("--extcap-capture-filter")
ap.add_argument("--capture", action="store_true")
ap.add_argument("--fifo")
ap.add_argument("--preset", default="6")
ap.add_argument("--custom", default="")
ap.add_argument("--refresh", action="store_true")
a, _ = ap.parse_known_args()

if a.refresh:
    refresh()
    sys.exit(0)

if a.extcap_interfaces:
    print("extcap {version=1.3}")
    for ad in get_adapters():
        print("interface {value=%s}{display=uwifi %s (%s %s, %s)}" %
              (ad["name"], ad["name"], ad["driver"], ad["usbid"], ad["speed"]))
    sys.exit(0)

if a.extcap_dlts:
    print("dlt {number=127}{name=IEEE802_11_RADIO}{display=802.11 + radiotap}")
    sys.exit(0)

if a.extcap_config:
    name = a.extcap_interface or ""
    info = load_cache().get("info", {}).get(name)
    if a.extcap_reload_option:          # only the reload button queries the adapter
        ad = next((x for x in get_adapters() if x["name"] == name), None)
        if ad:
            info = refresh_one(ad) or info
        print_values(info)
        sys.exit(0)
    print("arg {number=0}{call=--preset}{display=Channel}{type=selector}"
          "{reload=true}{placeholder=Reload}"
          "{tooltip=Built from uwifi info; use the reload button after changing adapters}")
    print_values(info)
    print("arg {number=1}{call=--custom}{display=Custom channels (overrides)}"
          "{type=string}{tooltip=Kismet notation. Examples: 6, 36VHT80, 6g:97HE160, 1,6,11,36VHT80. The number is the primary channel; 6GHz needs the 6g: prefix.}")
    sys.exit(0)

if a.capture:
    idx = next((x["index"] for x in get_adapters()
                if x["name"] == a.extcap_interface), None)
    if idx is None:
        with open(LOG, "a") as f:
            f.write("adapter %r not found\n" % a.extcap_interface)
        sys.exit(1)
    preset = a.custom or a.preset
    if preset.startswith("hop:"):
        info = load_cache().get("info", {}).get(a.extcap_interface, {})
        widths = ",".join(str(w) for w in sorted(
            {w for v in info.values() for w in v["widths"]})) or "20,40,80"
        cargs = ["-b", preset[4:], "-W", widths, "-t", "250"]
    else:
        cargs = ["-c", preset]
    out = os.open(a.fifo, os.O_WRONLY)
    err = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    os.dup2(out, 1)
    os.dup2(err, 2)
    os.execvp("sudo", ["sudo", "-n", UWIFI, "capture", "-d", str(idx)]
              + cargs + ["-w", "-"])
